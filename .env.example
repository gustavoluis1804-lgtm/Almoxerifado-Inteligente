PORT=3000

# Use apenas a Project URL base do Supabase, sem /rest/v1.
SUPABASE_URL=https://seu-projeto.supabase.co

# Preferencial para o backend: Project Settings > API > service_role key.
# Nunca coloque esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Mantido por compatibilidade com versoes antigas do projeto.
# SUPABASE_SECRET_KEY=sua-chave-server-side

GEMINI_API_KEY=sua-chave-gemini
GEMINI_MODEL=gemini-3.5-flash
